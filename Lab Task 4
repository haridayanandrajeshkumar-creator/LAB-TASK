#Q>
def palindrome(a):
    b=0
    t=0
    while t.0:
        d=t%10
        b=b*10+d
        t=t//10
    print("b",b)
    if b==a:
        print("Palindrome")
    else:
        print("Not Palindrome")
palindrome(131)

